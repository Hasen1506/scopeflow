# Copy to .env.local for development. Never commit .env.local or real credentials.
# Neon dashboard > Connect > pooled PostgreSQL connection string.
DATABASE_URL=
# Neon dashboard > Auth > enable Auth for the SAME branch > Auth URL.
NEON_AUTH_BASE_URL=
# Generate privately: openssl rand -base64 32. Keep stable across deployments.
NEON_AUTH_COOKIE_SECRET=
# Canonical external URL; use the Render HTTPS URL in production.
APP_URL=http://localhost:5173
# Seeds the Ed25519 key that signs client decisions and ledger entries. Generate once: openssl rand -base64 48
SCOPEFLOW_SIGNING_SECRET=
# Optional: public support role address shown in the UI (build time).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Optional: email review links from "Send for signature" through Resend. Set both, or neither
# (without them the workspace falls back to Copy link / Open in mail app).
RESEND_API_KEY=
# Verified sender, e.g. Scopeflow <scopes@your-domain>
SCOPEFLOW_MAIL_FROM=
# Optional Reply-To for those emails, e.g. your own inbox.
SCOPEFLOW_MAIL_REPLY_TO=
# Optional (PR F): deposit on signature through Razorpay. Set both keys (Dashboard > Settings > API Keys)
# to let clients pay the scope's deposit with Razorpay Checkout after approving. The webhook
# (Dashboard > Webhooks: URL <APP_URL>/api/payments/razorpay/webhook, events payment.captured and
# order.paid) is what marks a deposit paid and records it in the ledger; set its secret here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
