# Copy to .env.local for development. Never commit .env.local or real credentials.
# docs/DEPLOY.md explains each group; everything below "Required" is optional and off when unset.

# ---- Required ---------------------------------------------------------------------------------
# Neon dashboard > Connect > pooled PostgreSQL connection string.
DATABASE_URL=
# Neon dashboard > Auth > enable Auth for the SAME branch > Auth URL.
NEON_AUTH_BASE_URL=
# Generate privately: openssl rand -base64 32. Keep stable across deployments.
NEON_AUTH_COOKIE_SECRET=
# Canonical external URL; use the Render HTTPS URL in production.
APP_URL=http://localhost:5173
# Seeds the Ed25519 key that signs client decisions and ledger entries. Generate once: openssl rand -base64 48
# Required in production: a production build no longer signs with NEON_AUTH_COOKIE_SECRET (only when
# SCOPEFLOW_ALLOW_COOKIE_SIGNING=1, while migrating). Retired values go in SCOPEFLOW_SIGNING_SECRET_PREVIOUS.
SCOPEFLOW_SIGNING_SECRET=
SCOPEFLOW_SIGNING_SECRET_PREVIOUS=
# Optional: public support role address shown in the UI (build time).
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Email (Send for signature, one-time codes, reminders) ------------------------------------
# A verified sender, e.g. Scopeflow <scopes@your-domain>, plus ONE provider's credentials.
SCOPEFLOW_MAIL_FROM=
SCOPEFLOW_MAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
SCOPEFLOW_SES_ACCESS_KEY_ID=
SCOPEFLOW_SES_SECRET_ACCESS_KEY=
SCOPEFLOW_SES_REGION=
# SCOPEFLOW_SES_SESSION_TOKEN=
# Picks one when several are set (resend | postmark | ses); otherwise Resend, then Postmark, then SES.
SCOPEFLOW_MAIL_PROVIDER=
# Bounce/complaint webhooks: Postmark Basic password (SCOPEFLOW_MAIL_WEBHOOK_SECRET), Resend Svix
# secret (RESEND_WEBHOOK_SECRET), and the SES/SNS subscription token, sent as
# <APP_URL>/api/mail/events/ses?token=<SCOPEFLOW_SES_WEBHOOK_TOKEN>. Keep the SES token separate: it
# appears in URLs and logs. Unset, SES falls back to SCOPEFLOW_MAIL_WEBHOOK_SECRET (deprecated).
# SCOPEFLOW_MAIL_WEBHOOK_SECRET=
# RESEND_WEBHOOK_SECRET=
# SCOPEFLOW_SES_WEBHOOK_TOKEN=

# ---- SMS / WhatsApp one-time codes ------------------------------------------------------------
# MSG91 (India; needs a DLT-registered sender and template) or Twilio.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VAR=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# SCOPEFLOW_SMS_PROVIDER=msg91|twilio
# Local development and CI only (refused unless APP_URL is localhost): log codes instead of sending.
SCOPEFLOW_OTP_DEV=
SCOPEFLOW_OTP_DEV_LOG=

# ---- AI drafting and the scope-creep radar ----------------------------------------------------
# Off unless one key is set; OpenAI wins when both are (SCOPEFLOW_LLM_PROVIDER overrides).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SCOPEFLOW_LLM_PROVIDER=openai|anthropic
# SCOPEFLOW_OPENAI_MODEL, SCOPEFLOW_OPENAI_MODEL_CAREFUL, SCOPEFLOW_ANTHROPIC_MODEL, SCOPEFLOW_ANTHROPIC_MODEL_CAREFUL
# Optional meaning match for the radar (multilingual): openai (uses OPENAI_API_KEY) or voyage.
SCOPEFLOW_EMBEDDINGS=
VOYAGE_API_KEY=
# SCOPEFLOW_EMBEDDING_MODEL, SCOPEFLOW_EMBEDDING_MIN (similarity floor, default 0.45)

# ---- Email forwarding into the radar ----------------------------------------------------------
# Projects get scope-<token>@<domain>; point the mail provider's inbound webhook at
# <APP_URL>/api/inbound/email with the secret as a bearer token or basic-auth password.
SCOPEFLOW_INBOUND_DOMAIN=
SCOPEFLOW_INBOUND_SECRET=

# ---- Online payments --------------------------------------------------------------------------
# Razorpay (INR first): Dashboard > Settings > API Keys; webhook <APP_URL>/api/payments/razorpay/webhook
# (events payment.captured, order.paid).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe Checkout (other currencies): webhook <APP_URL>/api/payments/stripe/webhook (events
# checkout.session.completed, checkout.session.async_payment_succeeded).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: currencies Stripe takes, e.g. USD,EUR,GBP (default: every currency it is chosen for).
STRIPE_CURRENCIES=
# Authorizes the daily reconciliation call (POST /api/payments/razorpay/reconcile) from the cron job.
SCOPEFLOW_CRON_SECRET=

# ---- Evidence: timestamps and signed PDFs -----------------------------------------------------
# RFC 3161 timestamp authority (e.g. a qualified TSA); SCOPEFLOW_TSA_AUTH is sent as Authorization.
SCOPEFLOW_TSA_URL=
SCOPEFLOW_TSA_AUTH=
# PAdES signing of every PDF: a document-signing certificate and key (PEM text or file paths).
SCOPEFLOW_PDF_SIGN_CERT=
SCOPEFLOW_PDF_SIGN_KEY=
SCOPEFLOW_PDF_SIGN_KEY_PASSPHRASE=
# Extra TrueType fonts for scripts the bundled Noto fonts do not cover (comma-separated paths).
SCOPEFLOW_PDF_EXTRA_FONTS=

# ---- Money and retention ----------------------------------------------------------------------
# Reference exchange rates for the locked FX line (default: the ECB rates via api.frankfurter.dev; "off" disables).
SCOPEFLOW_FX_URL=
# Server-wide default retention (days) for client IP / user agent, for owners who set none.
SCOPEFLOW_CONTEXT_RETENTION_DAYS=
# Plan tier and limit overrides: SCOPEFLOW_PLAN=beta|free|solo, SCOPEFLOW_LIMIT_<NAME>=<n>
SCOPEFLOW_PLAN=
