{
  "name": "ContractLock",
  "short_name": "ContractLock",
  "description": "Check agreement traps, lock vendor & client terms via WhatsApp, and keep tamper-proof records before you pay.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0F1D55",
  "theme_color": "#0F1D55",
  "icons": [
    {"src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any"}
  ],
  "share_target": {
    "action": "/api/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "files", "accept": ["image/*"]}]
    }
  }
}
